<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="标题"
        android:textAppearance="@style/TextAppearance.Dsh.HeadlineSmall" />

    <TextView
        android:id="@+id/dialogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.3"
        android:maxLines="16"
        android:text="内容"
        android:textAppearance="@style/TextAppearance.Dsh.BodyMedium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogNegative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_text"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="64dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="取消"
            android:textAppearance="@style/TextAppearance.Dsh.LabelLarge"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dialogPositive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_text"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="64dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="知道了"
            android:textAppearance="@style/TextAppearance.Dsh.LabelLarge"
            android:textColor="@color/primary" />
    </LinearLayout>
</LinearLayout>
