[Unit]
Description=DSH Task Notify Cloud Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh-notify
Group=dsh-notify
WorkingDirectory=/opt/dsh-notify
EnvironmentFile=/etc/dsh-notify.env
ExecStart=/usr/local/bin/node /opt/dsh-notify/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dsh-notify

[Install]
WantedBy=multi-user.target
